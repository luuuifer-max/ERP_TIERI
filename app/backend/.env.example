# Configuración de PostgreSQL
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=false

# Puerto del backend
PORT=3000

# Secreto utilizado para firmar JWT
JWT_SECRET=

# Orígenes adicionales permitidos, separados por comas.
# localhost:5173 y 127.0.0.1:5173 se permiten automáticamente.
FRONTEND_ORIGINS=
